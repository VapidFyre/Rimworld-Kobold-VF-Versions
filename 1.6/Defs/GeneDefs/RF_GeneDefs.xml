<GeneDef ParentName="GeneJawBase">
    <defName>RF_KoboldHead</defName>
    <label>kobold head</label>
    <labelShortAdj>kobold-like</labelShortAdj>
    <description>Carriers of this gene possess a kobold head.</description>
    <displayCategory>Cosmetic</displayCategory>
    <displayOrderInCategory>98</displayOrderInCategory>
    <iconColor>(0.75, 0.75, 0.75)</iconColor>
    <iconPath>UI/GeneIcons/RF_AHead</iconPath>
    <forcedHeadTypes>
        <li>RF_KoboldHeadA</li>
        <li>RF_KoboldHeadC</li>
    </forcedHeadTypes>
</GeneDef>

<GeneDef ParentName="GeneJawBase">
    <defName>RF_KoboldHead_Mechanitor</defName>
    <label>kobold mechanitor head</label>
    <labelShortAdj>kobold-like but mechanitor</labelShortAdj>
    <description>Carriers of this gene possess a kobold mechanitor head. No tooth for biting.</description>
    <displayCategory>Cosmetic</displayCategory>
    <displayOrderInCategory>98</displayOrderInCategory>
    <iconColor>(0.75, 0.75, 0.75)</iconColor>
    <iconPath>UI/GeneIcons/RF_KoboldHeadB</iconPath>
    <forcedHeadTypes>
        <li>RF_KoboldHeadB</li>
    </forcedHeadTypes>
</GeneDef>

<GeneDef ParentName="GeneTailBase" Name="KoboldTailBase" Abstract="True">
    <description>Gene to kobold tail</description>
    <iconColor>(0.75, 0.75, 0.75)</iconColor>
    <displayOrderInCategory>30</displayOrderInCategory>
    <statOffsets>
        <ComfyTemperatureMin>-10</ComfyTemperatureMin>
    </statOffsets>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
</GeneDef>


<GeneDef ParentName="KoboldTailBase">
    <defName>RF_ATail</defName>
    <label>standard long tail</label>
    <iconPath>UI/GeneIcons/RF_ATail</iconPath>
    <renderNodeProperties>
        <li>
            <texPath>Things/Pawn/Humanlike/Tail/RF_KoboldTail_Standard_Long/RF_KoboldTail_Standard_Long</texPath>
            <shaderTypeDef>CutoutComplex</shaderTypeDef>
            <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
            <useSkinShader>True</useSkinShader>
            <overrideMeshSize>(1.0,1.0)</overrideMeshSize>
            <colorType>Skin</colorType>
            <parentTagDef>Body</parentTagDef>
            <drawData>
                <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
                <defaultData><layer>-2</layer></defaultData>
                <dataNorth>
                    <offset>(0,0,-0.5)</offset>
                    <layer>90</layer>
                </dataNorth>
                <dataSouth>
                    <offset>(-0.11,-0,-0.2)</offset>
                </dataSouth>
                <dataEast>
                    <offset>(-0.54,0,-0.25)</offset>
                </dataEast>
                <dataWest>
                    <offset>(0.54,0,-0.25)</offset>
                </dataWest>
            </drawData>
        </li>
    </renderNodeProperties>
</GeneDef>


<GeneDef ParentName="GeneHeadboneBase" Name="KoboldHornsBase" Abstract="True">
    <description>Kobold Gene for horns!</description>
    <randomChosen>true</randomChosen>
</GeneDef>

<GeneDef ParentName="KoboldHornsBase">
    <defName>RF_KoboldHorns_Stubby</defName>
    <label>stubby horns</label>
    <description>Kobold Gene for horns, stubby short ones! Looks kinda cute, not as comfortable to sleep around but not the worst thing.</description>
    <iconPath>UI/GeneIcons/RF_KoboldHorns_Stubby</iconPath>
    <renderNodeProperties>
        <li>
            <useSkinShader>true</useSkinShader>
            <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
			<workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
            <texPath>Things/Pawn/Humanlike/Horns/RF_KoboldHorns_Short</texPath>
            <color>(255,255,255)</color>
			<parentTagDef>Head</parentTagDef>
			<colorType>Custom</colorType>
            <drawData> <!-- God cursed my horns to be overlapping on the front-->
                <defaultData><layer>10</layer></defaultData>
                <dataNorth><layer>80</layer></dataNorth>
            </drawData>
        </li>
    </renderNodeProperties>
    <statOffsets>
        <PawnBeauty>0.5</PawnBeauty>
        <RestRateMultiplier>-0.05</RestRateMultiplier>
    </statOffsets>

</GeneDef>

<GeneDef ParentName="KoboldHornsBase">
    <defName>RF_KoboldHorns_Long</defName>
    <label>long horns</label>
    <description>Kobold Gene for horns, long standard ones! Looks cool, pretty not as comfortable to sleep around but helps with cooling down in the heat!</description>
