<GeneDef Name="GenePhysiologyBase" Abstract="True">
    <displayCategory>Miscellaneous</displayCategory>
    <exclusionTags>
        <li>Physiology</li>
    </exclusionTags>
    <randomChosen>true</randomChosen>
</GeneDef>

<GeneDef ParentName="GenePhysiologyBase">
    <defName>RF_Kobold_Physiology</defName>
    <label>kobold physiology</label>
    <description>Carriers of this gene is a kobold officially, they got some zoomies!!!</description>
    <biostatCpx>1</biostatCpx> <!-- capacity?-->
    <biostatArc>1</biostatArc>
    <biostatMet>0</biostatMet> <!-- Metabolism?-->
    <iconPath>UI/GeneIcons/RF_KoboldPhysiology</iconPath>
    <displayCategory>Archite</displayCategory> <!-- we dont want this to be extractable lmao but still possible, findout how to make pawn small look-->
    <statOffsets>
        <MoveSpeed>0.9</MoveSpeed>
        <MeleeDodgeChance>5</MeleeDodgeChance>
        <CarryingCapacity>-25</CarryingCapacity>
        <MeatAmount>-20</MeatAmount>
        <ArmorRating_Blunt>-0.1</ArmorRating_Blunt>
        <ArmorRating_Sharp>0.1</ArmorRating_Sharp>
        <RoyalFavorValue>-2</RoyalFavorValue>
    </statOffsets>
</GeneDef>

<GeneDef ParentName="GenePhysiologyBase">
    <defName>RF_Kobold_Physiology_Rare</defName>
    <label>kobold physiology</label>
    <description>Carriers of this gene is a kobold officially, this one can hear something in the walls... (it's more kobolds (trying to give them psylink level at start but cant find it)) </description>
    <biostatCpx>1</biostatCpx> <!-- capacity?-->
    <biostatArc>1</biostatArc>
    <biostatMet>0</biostatMet> <!-- Metabolism?-->
    <iconPath>UI/GeneIcons/RF_KoboldPhysiology_Rare</iconPath>
    <displayCategory>Archite</displayCategory> <!-- we dont want this to be extractable lmao but still possible, findout how to make pawn small look-->
    <statOffsets>
        <MoveSpeed>0.9</MoveSpeed>
        <CarryingCapacity>-25</CarryingCapacity>
        <MeatAmount>-20</MeatAmount>
        <ArmorRating_Blunt>-0.2</ArmorRating_Blunt>
        <PsychicSensitivity>0.3</PsychicSensitivity>
        <MeditationFocusGain>0.15</MeditationFocusGain>
        <PsychicEntropyRecoveryRate>0.15</PsychicEntropyRecoveryRate>
        <RoyalFavorValue>4</RoyalFavorValue>
    </statOffsets>
</GeneDef>

<GeneDef ParentName="GenePhysiologyBase">
    <defName>RF_Kobold_Physiology_Mechanitor</defName>
    <label>kobold mechanitor physiology</label>
    <description>Carriers of this gene possess kobold physiology adapted for mechanitor life, their flesh weakened.</description>
    <biostatCpx>1</biostatCpx> <!-- capacity?-->
    <biostatArc>1</biostatArc>
    <biostatMet>0</biostatMet> <!-- Metabolism?-->
    <iconPath>UI/GeneIcons/RF_KoboldPhysiology_Mechanitor</iconPath>
    <displayCategory>Archite</displayCategory> <!-- we dont want this to be extractable lmao but still possible, findout how to make pawn small look-->
    <statOffsets>
        <MoveSpeed>0.45</MoveSpeed>
        <CarryingCapacity>-35</CarryingCapacity>
        <MeatAmount>-40</MeatAmount>
        <ArmorRating_Blunt>-0.2</ArmorRating_Blunt>
        <MechBandwidth>6</MechBandwidth>
        <MechControlGroups>1</MechControlGroups>
        <RoyalFavorValue>3</RoyalFavorValue>
    </statOffsets>
</GeneDef>

</Defs>