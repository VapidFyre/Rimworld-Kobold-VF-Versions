<?xml version="1.0" encoding="UTF-8"?>

<Defs>


    <GeneDef ParentName="GeneEarsBase" Name="KoboldEarsBase" Abstract="True">
    <randomChosen>true</randomChosen>
    </GeneDef>

<GeneDef ParentName="KoboldEarsBase">
    <defName>RF_KoboldEars</defName> 
    <label>kobold ears</label>
    <description>Carriers of this gene possess kobold-like ears.</description>
    <iconColor>(0.75, 0.75, 0.75)</iconColor>
    <iconPath>UI/GeneIcons/RF_AEars</iconPath>
    <renderNodeProperties>
        <li>
            <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
            <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
            <texPaths>
                <li>Things/Pawn/Humanlike/Ears/RF_KoboldEarsA/RF_KoboldEarsA</li>
                <li>Things/Pawn/Humanlike/Ears/RF_KoboldEarsA/RF_KoboldEarsA_Attentive</li>
            </texPaths>
            <useSkinShader>True</useSkinShader>
            <colorType>Skin</colorType>
            <parentTagDef>Head</parentTagDef>
            <drawData>
                <defaultData>
                    <layer>60</layer>
                </defaultData>
                <dataNorth>
                    <offset>(0.0, -0.1, 0.0)</offset>
                </dataNorth>
                <dataSouth>
                    <offset>(0.0, -0.1, 0.0)</offset>
                </dataSouth>
                <dataEast>
                    <offset>(-0.05, 0.0, 0.0)</offset>
                </dataEast>
            </drawData>
        </li>
    </renderNodeProperties>
</GeneDef>

