    </statOffsets>
</GeneDef>

<GeneDef ParentName="KoboldHornsBase">
    <defName>RF_KoboldHorns_LongCurl</defName>
    <label>long curly horns</label>
    <description>Kobold Gene for horns, long curly ones! Looks real cool!! Like mine ;3c but not comfortable at all to sleep around but helps with cooling down in the heat and carry a bit more by hanging them by the horns.</description>
    <iconPath>UI/GeneIcons/RF_KoboldHorns_LongCurl</iconPath>
    <renderNodeProperties>
        <li>
            <useSkinShader>true</useSkinShader>
            <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
