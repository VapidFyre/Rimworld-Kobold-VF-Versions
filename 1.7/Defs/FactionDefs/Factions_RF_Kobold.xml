<?xml version="1.0" encoding="utf-8" ?>
<Defs>


    <!--  There are friendly, initially hostile, and permanently hostile factions, then there are 2 tech levels, industrial and tribal. 
        A fully custom definition will let you create a far more varied set of factions, 
        using custom levels of technology, but for the sake of this guide, we're going to use a preset that was defined by Ludeon. -->
  <FactionDef Name="Kobold_Tribe" ParentName="TribeBase"> <!-- allows an already made template rimworld use for factions-->
    <defName>RF_Kobold_Tribe</defName>
    <label>Kobold Tribe</label>
    <description>Kobold Tribe Description! Spawnin all over the place, but tribal!</description>
    <techLevel>Neolithic</techLevel>
    <colorSpectrum>
      <li>(0.7, 0.6, 0.0)</li> <!-- color spectrum from first to second li like 0.7-1.0 -->
      <li>(1.0, 0.5, 0.2)</li>
    </colorSpectrum>
    <factionIconPath>World/Factions/RF_Kobold_Tribe</factionIconPath>
    <requiredCountAtGameStart>0</requiredCountAtGameStart>
    <startingCountAtWorldCreation>1</startingCountAtWorldCreation>
    <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation> <!-- no reason to edit, if wanted only 1 custom faction then sure, most temps have this defined. 
                                                                                some factions like TribeBase and OutlanderFactionBase dont have it though, otherwise delete-->        
    <configurationListOrderPriority>30</configurationListOrderPriority> <!-- mainly to just organize order, most faction types have this defined, lower show up first-->
    <!-- <factionIconPath>Path/To/Icon</factionIconPath> Reference image in textures, similar to iconPath in Xenotype Def, optional as with borrowing from parent, if want make
                                                        do it with icon white and trans bg-->     
    <xenotypeSet Inherit="False">
      <xenotypeChances>
        <RF_Kobold_Tribal>0.85</RF_Kobold_Tribal>
        <RF_Kobold>0.10</RF_Kobold>
        <RF_Kobold_Mechanitor>0.05</RF_Kobold_Mechanitor>
        <!-- can add more multiple xenotypes as odds of xeno appearing in member of faction-->
      </xenotypeChances>
    </xenotypeSet>
  </FactionDef>

  <FactionDef ParentName="OutlanderFactionBase">
    <defName>RF_Kobold_City</defName>
    <label>Kobold City</label>
    <description>Kobold City Description! Spawnin all over the place, but city-dwellers! All forms of 'bold can be found!</description>
    <techLevel>Industrial</techLevel>
    <colorSpectrum>
      <li>(0.8, 0.4, 0.1)</li>
      <li>(1.0, 0.55, 0.15)</li>
    </colorSpectrum>
    <factionIconPath>World/Factions/RF_Kobold_City</factionIconPath>
    <requiredCountAtGameStart>0</requiredCountAtGameStart>
    <startingCountAtWorldCreation>1</startingCountAtWorldCreation>
    <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>30</configurationListOrderPriority>
    <xenotypeSet Inherit="False">
      <xenotypeChances>
        <RF_Kobold>0.60</RF_Kobold>
        <RF_Kobold_Tribal>0.20</RF_Kobold_Tribal>
        <RF_Kobold_Mechanitor>0.20</RF_Kobold_Mechanitor>
      </xenotypeChances>
    </xenotypeSet>
  </FactionDef>

  <FactionDef ParentName="TribeBase">
    <defName>RF_Kobold_Rural</defName>
    <label>Kobold Rural</label>
    <description>Kobold Rural Description! Spawnin all over the place, but rural! Slow and nice life...</description>
    <techLevel>Medieval</techLevel>
    <colorSpectrum>
      <li>(0.7, 0.6, 0.0)</li>
      <li>(1.0, 0.5, 0.2)</li>
    </colorSpectrum>
    <factionIconPath>World/Factions/RF_Kobold_Rural</factionIconPath>
    <requiredCountAtGameStart>0</requiredCountAtGameStart>
    <startingCountAtWorldCreation>1</startingCountAtWorldCreation>
    <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>30</configurationListOrderPriority>
    <xenotypeSet Inherit="False">
      <xenotypeChances>
        <RF_Kobold_Tribal>0.67</RF_Kobold_Tribal>
        <RF_Kobold>0.21</RF_Kobold>
        <RF_Kobold_Mechanitor>0.12</RF_Kobold_Mechanitor>
      </xenotypeChances>
    </xenotypeSet>
  </FactionDef>

</Defs>